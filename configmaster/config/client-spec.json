{
  "schemaVersion": "1.0.0",
  "client": "Northwind Platform",
  "requiredFields": ["app.name", "app.port"],
  "fieldTypes": {
    "app.name": "string",
    "app.port": "integer",
    "app.region": "string",
    "app.features": "array"
  },
  "mergeStrategies": {
    "app.features": "append_list",
    "app.region": "fail_on_conflict"
  },
  "defaultMergeStrategy": "override"
}
